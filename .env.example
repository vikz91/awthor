# Public production origin used for absolute Open Graph and X image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Clerk email-code account. Leave both blank to keep Awthor fully local-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional authenticated sync storage. Configure this alongside Clerk to enable sync.
# Never expose either value with NEXT_PUBLIC_.
MONGODB_URI=
MONGODB_DB=awthor
