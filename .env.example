# Public production origin used for absolute Open Graph and X image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Clerk email-code account. Leave both blank to keep Awthor fully local-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional authenticated sync storage. Configure this alongside Clerk to enable sync.
# Never expose either value with NEXT_PUBLIC_.
MONGODB_URI=
MONGODB_DB=awthor

# Optional remote MCP. Configure Clerk as an OAuth authorization server with
# awthor.read, awthor.write, and awthor.publish scopes, then set its issuer URL.
# Comma-separated extra browser origins are permitted for MCP requests; non-browser
# MCP clients authenticate with OAuth Bearer tokens and do not need this setting.
CLERK_OAUTH_AUTHORIZATION_SERVER_URL=
MCP_ALLOWED_ORIGINS=
